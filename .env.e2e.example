# Salin ke .env.e2e (JANGAN di-commit). Gunakan project Supabase STAGING, bukan production.
VITE_SUPABASE_URL=https://STAGING_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key hanya untuk setup/teardown tes (tidak diawali VITE_, jadi tidak masuk bundle frontend)
E2E_SUPABASE_SECRET_KEY=sb_secret_xxx
# Pengaman: harus sama dengan bagian depan URL di atas
E2E_PROJECT_REF=STAGING_REF
